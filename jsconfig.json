{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "*": ["./src/*"]
    }
  },
  "include": ["src/**/*.js", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "build", "release"]
}
